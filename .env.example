# YT Translator Environment Variables (Optional)
# If left empty, the application runs fully standalone (Direct YouTube InnerTube on Android & Local Whisper AI)

# Cloudflare Worker API Proxy (Optional self-hosted instance)
# Example: https://your-worker-name.your-account.workers.dev
VITE_WORKER_API_BASE_URL=

# Shared Secret Token for your Cloudflare Worker (matches APP_TOKEN in worker environment)
VITE_WORKER_APP_TOKEN=
