{
  "name": "yt-translator-monorepo",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/app"
  ],
  "scripts": {
    "dev": "npm --workspace apps/app run dev",
    "build": "npm --workspace apps/app run build",
    "build:all": "npm --workspace apps/app run build",
    "test": "vitest run",
    "deploy-ota": "node scripts/deploy-ota.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/splash-screen": "^8.0.2",
    "@floating-ui/react": "^0.27.20",
    "@huggingface/transformers": "^4.3.0",
    "capacitor-plugin-send-intent": "^0.0.2",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "archiver": "^8.0.0",
    "oxlint": "^1.71.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
